# Server-side environment variables
# Add your server-side variables here

# Clerk
# Get these keys from https://dashboard.clerk.com/
# CLERK_SECRET_KEY=

# Upstash Redis
# Get these values from https://console.upstash.com/redis
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob
# Get this from your Vercel project settings (Storage > Blob)
# BLOB_READ_WRITE_TOKEN=

# Resend Email
# Get this API key from https://resend.com/api-keys
# RESEND_API_KEY=

# Client-side environment variables
# Must be prefixed with PUBLIC_ to be accessible on the client
# PUBLIC_CLERK_PUBLISHABLE_KEY=
# PUBLIC_API_URL=
