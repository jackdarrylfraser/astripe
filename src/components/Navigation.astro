---
import { navigationLinks } from "../lib/navigation";

const links = navigationLinks(Astro.url.pathname, Boolean(Astro.locals.auth().userId));
---

<nav class="site-nav" aria-label="Main navigation">
  {links.map((link) => (
    <a class="nav-link" href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>
  ))}
</nav>
