---
import { SignOutButton } from "@clerk/astro/components";
import "../styles/site.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const { userId } = Astro.locals.auth();
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-wordmark" href="/" aria-label="Astripe home">Astripe</a>
        <nav class="site-nav" aria-label="Main navigation">
          <slot name="nav" />
          {userId && (
            <SignOutButton redirectUrl="/" asChild>
              <button type="button" class="nav-link nav-sign-out">Sign out</button>
            </SignOutButton>
          )}
        </nav>
      </header>
      <main class="site-main">
        <slot name="body" />
      </main>
    </div>
  </body>
</html>
