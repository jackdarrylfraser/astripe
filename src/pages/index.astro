---
import BaseLayout from "../layouts/BaseLayout.astro";

const { userId } = Astro.locals.auth();
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<BaseLayout title="Astripe">
  <section slot="body" aria-labelledby="home-title">
    <p class="page-kicker">Welcome to Astripe</p>
    <h1 id="home-title" class="page-title">A better way to be a member.</h1>
    <p class="page-intro">
      Join Astripe to get access to everything included with your membership.
    </p>
    <div class="action-row">
      <a class="clerk-button clerk-button--primary" href="/pricing">Explore membership</a>
      {userId ? (
        <a class="text-link" href="/account">Your account</a>
      ) : (
        <a class="text-link" href="/sign-in">Already a member? Sign in</a>
      )}
    </div>
  </section>
</BaseLayout>
