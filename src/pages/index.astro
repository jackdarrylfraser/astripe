---
import { Show, SignInButton, SignUpButton, UserButton } from "@clerk/astro/components";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Astripe</title>
  </head>
  <body>
    <main>
      <h1>Astripe</h1>
      <p>A basic Astro starter built with Bun.</p>
      <Show when="signed-out">
        <SignInButton />
        <SignUpButton />
      </Show>
      <Show when="signed-in">
        <UserButton />
      </Show>
    </main>
  </body>
</html>
