---
import { Show, SignInButton, SignUpButton, UserButton } from "@clerk/astro/components";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Astripe">
  <a slot="nav" class="nav-link" href="/pricing">Pricing</a>
  <a slot="nav" class="nav-link" href="/members">Members area</a>
  <Fragment slot="body">
    <h1 class="page-title page-title--home">Astripe</h1>
    <p class="page-intro">A basic Astro starter built with Bun.</p>
    <div class="action-row">
      <Show when="signed-out">
        <SignInButton asChild>
          <button class="clerk-button clerk-button--secondary" type="button">Sign in</button>
        </SignInButton>
        <SignUpButton asChild>
          <button class="clerk-button clerk-button--primary" type="button">Create account</button>
        </SignUpButton>
      </Show>
      <Show when="signed-in">
        <UserButton />
      </Show>
    </div>
  </Fragment>
</BaseLayout>
