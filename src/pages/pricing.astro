---
import { PricingTable, Show, SignInButton, UserButton } from "@clerk/astro/components";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Pricing | Astripe">
  <a slot="nav" class="nav-link" href="/">Home</a>
  <a slot="nav" class="nav-link" href="/members">Members area</a>
  <Fragment slot="body">
    <Show when="signed-in">
      <div class="user-button-row">
        <UserButton />
      </div>
    </Show>
    <h1 class="page-title page-title--section">Pricing</h1>
    <p class="page-intro">Choose a plan that includes site access to enter the members area.</p>
    <div class="action-row">
      <Show when="signed-out">
        <p class="m-0 text-muted">Already have an account?</p>
        <SignInButton asChild fallbackRedirectUrl="/pricing">
          <button class="clerk-button clerk-button--secondary" type="button">Sign in</button>
        </SignInButton>
      </Show>
    </div>
    <div class="mt-8">
      <PricingTable for="user" newSubscriptionRedirectUrl="/members" />
    </div>
  </Fragment>
</BaseLayout>
