---
import { clerkClient } from "@clerk/astro/server";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublicUserPlans } from "../lib/billing";

const { userId } = Astro.locals.auth();
const plans = await getPublicUserPlans(clerkClient(Astro).billing);
const subscribeUrl = userId ? "/subscribe" : "/sign-in?redirect_url=%2Fsubscribe";
---

<BaseLayout title="Pricing | Astripe">
  <a slot="nav" class="nav-link" href="/">Home</a>
  {userId ? (
    <a slot="nav" class="nav-link" href="/account">Account</a>
  ) : (
    <a slot="nav" class="nav-link" href="/sign-in">Sign in</a>
  )}
  {!userId && <a slot="nav" class="nav-link" href="/sign-up">Sign up</a>}
  <section slot="body" class="pricing-page" aria-labelledby="pricing-title">
    <p class="page-kicker">Membership</p>
    <h1 id="pricing-title" class="page-title page-title--section">Find your plan.</h1>
    <p class="page-intro">Explore what's included, then sign in to choose your subscription.</p>

    {plans.length ? (
      <div class="pricing-grid">
        {plans.map((plan) => (
          <article class="pricing-card">
            <h2>{plan.name}</h2>
            {plan.description && <p class="pricing-description">{plan.description}</p>}
            <div class="pricing-prices">
              {plan.fee && (
                <p><strong>{plan.fee.currencySymbol}{plan.fee.amountFormatted} {plan.fee.currency}</strong> {plan.isRecurring ? "/ month" : "one-time"}</p>
              )}
              {plan.annualFee && (
                <p><strong>{plan.annualFee.currencySymbol}{plan.annualFee.amountFormatted} {plan.annualFee.currency}</strong> / year</p>
              )}
              {!plan.fee && !plan.annualFee && <p>Pricing available at checkout.</p>}
            </div>
            {plan.freeTrialEnabled && plan.freeTrialDays && (
              <p>{plan.freeTrialDays}-day free trial</p>
            )}
            <a class="clerk-button clerk-button--primary pricing-action" href={subscribeUrl}>Continue to subscribe</a>
          </article>
        ))}
      </div>
    ) : (
      <p>No membership plans are currently available. Please check back later.</p>
    )}
  </section>
</BaseLayout>
