---
import { SignOutButton, UserProfile } from "@clerk/astro/components";
import BaseLayout from "../layouts/BaseLayout.astro";

if (!Astro.locals.auth().userId) {
  const response = Astro.redirect("/sign-in?redirect_url=%2Faccount");
  response.headers.set("Cache-Control", "private, no-store");
  return response;
}

Astro.response.headers.set("Cache-Control", "private, no-store");
---

<BaseLayout title="Your account | Astripe">
  <a slot="nav" class="nav-link" href="/activities">Activities</a>
  <a slot="nav" class="nav-link" href="/account" aria-current="page">Account</a>
  <section slot="body" class="account-page" aria-labelledby="account-title">
    <p class="page-kicker">Your membership</p>
    <h1 id="account-title" class="page-title page-title--section">Your account.</h1>
    <div class="account-actions">
      <p class="page-intro">Manage your profile and account settings.</p>
      <SignOutButton redirectUrl="/" asChild>
        <button type="button" class="clerk-button clerk-button--secondary">Sign out</button>
      </SignOutButton>
    </div>
    <div class="account-profile">
      <UserProfile routing="hash" />
    </div>
  </section>
</BaseLayout>
