---
import { SignUp } from "@clerk/astro/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import { authDestination, authPath } from "../lib/auth-redirect";
import { authAppearance } from "../lib/auth-appearance";

const destination = authDestination(Astro.url);
if (Astro.locals.auth().userId) {
  const response = Astro.redirect(destination);
  response.headers.set("Cache-Control", "private, no-store");
  return response;
}
---

<BaseLayout title="Create an account | Astripe">
  <section slot="body" class="auth-page" aria-label="Create an account">
    {destination === "/subscribe" && (
      <p class="auth-message">Create an account to sign up for a subscription.</p>
    )}
    <div class="sign-in-card">
      <SignUp routing="hash" appearance={authAppearance} signInUrl={authPath("/sign-in", destination)} forceRedirectUrl={destination} signInForceRedirectUrl={destination} />
    </div>
  </section>
</BaseLayout>
