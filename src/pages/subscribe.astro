---
import { PricingTable } from "@clerk/astro/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import { authPath } from "../lib/auth-redirect";

if (!Astro.locals.auth().userId) {
  const response = Astro.redirect(authPath("/sign-in", "/subscribe"));
  response.headers.set("Cache-Control", "private, no-store");
  return response;
}
---

<BaseLayout title="Subscribe | Astripe">
  <section slot="body" class="pricing-page" aria-labelledby="subscribe-title">
    <p class="page-kicker">Membership</p>
    <h1 id="subscribe-title" class="page-title page-title--section">Choose your subscription.</h1>
    <p class="page-intro">Select a plan below to review your subscription and complete checkout.</p>
    <PricingTable for="user" newSubscriptionRedirectUrl="/account" />
  </section>
</BaseLayout>
