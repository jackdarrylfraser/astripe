---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ActivityCard from "../components/ActivityCard.astro";
import { activitiesWithSlugs } from "../lib/activity-slugs";
import { memberAccessRedirect } from "../lib/member-access";

const redirect = memberAccessRedirect(Astro.locals.auth(), "/activities");
if (redirect) {
  const response = Astro.redirect(redirect);
  response.headers.set("Cache-Control", "private, no-store");
  return response;
}

Astro.response.headers.set("Cache-Control", "private, no-store");

const entries = await getCollection("activities");
entries.sort((left, right) => right.data.date.getTime() - left.data.date.getTime());
const activities = activitiesWithSlugs(entries);
---

<BaseLayout title="Activities | Astripe">
  <section slot="body" class="activities-page" aria-labelledby="activities-title">
    <h1 id="activities-title" class="page-title page-title--section">Activities.</h1>
    <p class="page-intro">Explore the latest activities included with your membership.</p>
    {activities.length > 0 ? (
      <div class="activity-list">
        {activities.map(({ entry, slug }) => <ActivityCard entry={entry} slug={slug} />)}
      </div>
    ) : (
      <p class="activity-empty">There are no activities yet. Check back soon.</p>
    )}
  </section>
</BaseLayout>
